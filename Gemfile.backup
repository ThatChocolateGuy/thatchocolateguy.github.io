# Jekyll 4.x Gemfile - Phase 3 Migration
# Ruby 3.3.4 Compatible

source "https://rubygems.org"

# Core Jekyll 4.x
gem "jekyll", "~> 4.3.0"

# Modern SASS compilation
gem "sassc", "~> 2.4.0"  # Replaces deprecated sass gem
gem "jekyll-sass-converter", "~> 3.0"

# Syntax highlighting (modern Rouge)
gem "rouge", "~> 4.0"

# Essential Jekyll plugins
gem "jekyll-feed", "~> 0.17"         # RSS feed generation
gem "jekyll-sitemap", "~> 1.4"       # XML sitemap
gem "jekyll-seo-tag", "~> 2.8"       # SEO optimization
gem "jekyll-paginate-v2", "~> 3.0"   # Modern pagination

# Kramdown (Markdown parser)
gem "kramdown", "~> 2.4"
gem "kramdown-parser-gfm", "~> 1.1"  # GitHub Flavored Markdown

# Development tools
gem "webrick", "~> 1.8"              # Ruby 3.x web server

# Optional performance improvements
gem "jekyll-compose", "~> 0.12", group: [:jekyll_plugins]

group :development, :test do
  gem "html-proofer", "~> 4.4"       # HTML validation
end

# Windows and JRuby compatibility
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Performance-booster for watching directories on Windows
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]

# Lock `http_parser.rb` gem to `v0.6.x` on JRuby builds since newer versions
# of the gem do not have a Java counterpart.
gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]