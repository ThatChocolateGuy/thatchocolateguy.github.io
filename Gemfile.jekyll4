source "https://rubygems.org"

# Specify Ruby version requirement for Jekyll 4.x
ruby ">= 2.5.0"

# Phase 3: Modern Jekyll 4.x stack (requires Ruby 2.5+)
gem "jekyll", "~> 4.3.3"
gem "rake", "~> 13.1"
gem "webrick", "~> 1.8"  # Required for Jekyll serve on Ruby 3.0+

# If you want to use GitHub Pages, remove the "gem "jekyll"" above and
# uncomment the line below. To upgrade, run `bundle update github-pages`.
# gem "github-pages", group: :jekyll_plugins

# Modern Jekyll 4.x plugins
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-paginate-v2", "~> 3.0"
  gem "rouge", "~> 4.2"
  gem "jekyll-compose", "~> 0.12"
  gem "kramdown", "~> 2.4"
  gem "kramdown-parser-gfm", "~> 1.1"
end

# Additional gems for enhanced functionality
group :development do
  gem "listen", "~> 3.8"
end